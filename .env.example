# Roboflow API Configuration
# Obtén tus claves en https://roboflow.com
ROBOFLOW_API_KEY=your_api_key_here
ROBOFLOW_PUBLISHABLE_KEY=your_publishable_key_here
ROBOFLOW_WORKSPACE=inkyu-sa-e0c78
ROBOFLOW_PROJECT=dfl-bundesliga-soccer-football-gpqdy

# ElevenLabs TTS Configuration
# ELEVENLABS_API_KEY nunca debe commitearse con un valor real.
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_voice_id_here
ELEVENLABS_FEMALE_VOICE_ID=your_female_voice_id_here
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_LANGUAGE_CODE=es

# Voice settings opcionales. Déjalos vacíos para usar los defaults de la voz.
ELEVENLABS_STABILITY=
ELEVENLABS_SIMILARITY_BOOST=
ELEVENLABS_STYLE=
ELEVENLABS_SPEED=
ELEVENLABS_USE_SPEAKER_BOOST=
ELEVENLABS_OPTIMIZE_STREAMING_LATENCY=
